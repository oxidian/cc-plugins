// For a repository with unified tooling:
{
  "base_ref": "origin/main",
  "checks": [
    {
      "fast": "uv run ruff format .",
      "slow": "uv run ruff check ."
    }
  ]
}

// For a repository with submodules using different tooling:
{
  "base_ref": "origin/main",
  "checks": [
    {
      "directory": "backend",
      "fast": "make format",
      "slow": "make check"
    },
    {
      "directory": "frontend",
      "fast": "npm run format",
      "slow": "npm run check"
    },
    {
      "directory": "hocuspocus",
      "fast": "npm run format",
      "slow": "npm run check"
    }
  ]
}
